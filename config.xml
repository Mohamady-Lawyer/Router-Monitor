<?xml version='1.0' encoding='utf-8'?>
<widget id="com.momo.routermonitor" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Router Monitor</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <edit-config target="application" file="app/src/main/AndroidManifest.xml" mode="merge">
        <application android:usesCleartextTraffic="true" />
    </edit-config>
</widget>
